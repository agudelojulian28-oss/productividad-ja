# ─────────────────────────────────────────────────────────────────────────
#  Copia este archivo a  .env.local  y rellena los valores.
#  .env.local está en .gitignore y NUNCA se sube al repositorio.
#  🔴 = secreto: ponlo directo en .env.local, no lo pegues en ningún chat.
#
#  Este proyecto usa el sistema NUEVO de llaves de Supabase
#  (sb_publishable_... / sb_secret_...), no el viejo (anon / service_role).
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase · Etapa 0 ───────────────────────────────────────────────────
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Settings → API → Publishable key (sb_publishable_...) — pública
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 🔴 Settings → API → Secret keys (sb_secret_...) — solo canales y migraciones
SUPABASE_SECRET_KEY=
# 🔴 Settings → Database → Connection string → "Session pooler" (IPv4).
#    Reemplaza [YOUR-PASSWORD] por la contraseña del proyecto.
#    NO uses el "Transaction pooler" (6543): no soporta pg_dump ni migraciones.
SUPABASE_DB_URL=
# Referencia del proyecto (el subdominio de tu Project URL)
SUPABASE_PROJECT_REF=
# 🔴 Firma del JWT efímero del worker. Con el sistema nuevo de llaves puede estar
#    en Settings → API → JWT Keys (secreto legado) o requerir firma asimétrica.
#    Validar antes de la Etapa 3 (ADR-018). No hace falta para la Etapa 0.
SUPABASE_JWT_SECRET=

# ── Worker interno · Etapa 3 ─────────────────────────────────────────────
# 🔴 Genera con:  openssl rand -hex 32
WORKER_SECRET=

# ── Anthropic (agente) · Etapa 2 ─────────────────────────────────────────
# 🔴 console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Google Calendar · Etapa 1 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
# 🔴
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# 🔴 Clave AES-256 para cifrar los refresh tokens.  openssl rand -hex 32
GOOGLE_TOKEN_ENC_KEY=

# ── WhatsApp Cloud API · Etapa 3 (canal activo, ADR-020) ─────────────────
# App de Meta → WhatsApp → API Setup (no es secreto)
WHATSAPP_PHONE_NUMBER_ID=
# 🔴 Token permanente de un "Usuario del sistema" (NO el temporal de 24 h)
WHATSAPP_TOKEN=
# 🔴 App → Settings → Basic → App Secret (verifica la firma del webhook)
WHATSAPP_APP_SECRET=
# 🔴 Lo inventas tú; el mismo valor va en la config del webhook en Meta.  openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# Tu número personal de WhatsApp (lista blanca). Solo dígitos con indicativo, ej. 573001234567
WHATSAPP_ALLOWED_NUMBER=

# ── Telegram · alternativa (no activa; ver ADR-020) ──────────────────────
# 🔴 De @BotFather
TELEGRAM_BOT_TOKEN=
# 🔴 openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Usuario único ────────────────────────────────────────────────────────
# 🔴 UUID del único usuario en Supabase (auth.users.id). El worker firma el JWT
#    efímero con este `sub` para reclamar el inbox bajo RLS (ADR-017).
#    NO es un chat_id ni un número: es el UUID de Authentication → Users.
ALLOWED_USER_ID=
# URL pública del despliegue para la ruta rápida y el barrido del worker (opcional;
# por defecto usa el origin del request). Ej. https://productividad-ja.vercel.app
WORKER_PUBLIC_URL=

# ── Voz · Aura (asistente de voz) ────────────────────────────────────────
# Transcripción de voz→texto (ya usada por el chat). console.groq.com → API Keys
GROQ_API_KEY=
# 🔴 Voz natural de Aura (texto→voz, en español, de mujer). SIN esta clave, Aura
#    usa la voz del navegador (gratis, menos natural). platform.openai.com → API keys
OPENAI_API_KEY=
# Opcionales para afinar la voz de nube (por defecto: gpt-4o-mini-tts, voz 'coral'):
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=coral
# TTS_BASE_URL=https://api.openai.com/v1
