{
  "name": "productividad-ja",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "depcruise core adapters app lib --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:security": "supabase test db",
    "check:rls": "node --env-file-if-exists=.env.local scripts/check-rls.mjs",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --linked > lib/database.types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "pg": "^8.22.0",
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
